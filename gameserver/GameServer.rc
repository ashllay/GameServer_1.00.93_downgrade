/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDI_GAMESERVER          ICON    DISCARDABLE     "GameServer.ICO"

/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDC_GAMESERVER MENU DISCARDABLE 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "All User Close",              ID_MENU_DISCONNECT
        MENUITEM "All User LogOut",             ID_MENU_USERLOGOUT
        MENUITEM SEPARATOR
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       IDM_EXIT
    END
    POPUP "&Load"
    BEGIN
        MENUITEM "&Monster Position Reload",    ID_LOAD_MONSTERPOS
        MENUITEM "&Shop Reload",                ID_LOAD_SHOP
        MENUITEM "MapServer Info Reload",       ID_LOAD_MAPSVRINFO
        MENUITEM "CastleSiege Reload",          ID_LOAD_CASTLESIEGE
        MENUITEM SEPARATOR
        MENUITEM "GameGuard Info Load",         ID_GAMEGUARD_MODULE_UPDATE
        MENUITEM "CashShop Option Load",        ID_MENUSHOPLISTRELOAD
        MENUITEM "IP Load",                     ID_LOAD_ACCEPTIPLOAD, GRAYED
        MENUITEM "&Option Reload",              ID_MENUGAMESERVEROPTIONLOAD
    END
    POPUP "&Event Load"
    BEGIN
        MENUITEM "Reload All Event",            ID_EVENTLOAD_ALL
        MENUITEM SEPARATOR
        MENUITEM "Reload DevilSquare",          ID_EVENTLOAD_DEVILSQUARE
        MENUITEM "Reload BloodCastle",          ID_EVENTLOAD_BLOODCASTLE
        MENUITEM "Reload ChaosCastle",          ID_EVENTLOAD_CHAOSCASTLE
        MENUITEM SEPARATOR
        MENUITEM "Reload UnderWorld Attack",    ID_EVENTLOAD_UNDERTROOPATTACK

        MENUITEM "Reload GoldenTroop Attack",   ID_EVENTLOAD_GOLDENTROOPATTACK

        MENUITEM "Reload WhiteMage Attack",     ID_EVENTLOAD_WHITEMAGEATTACK
        MENUITEM SEPARATOR
        MENUITEM "Reload Love PangPang",        ID_EVENTLOAD_LOVEPANGPANG
        MENUITEM "Reload FireCracker",          ID_EVENTLOAD_FIRECRACKER
        MENUITEM "Reload X-Mas Star",           ID_EVENTLOAD_XMASSTAR
        MENUITEM "Reload Heart of Love",        ID_EVENTLOAD_HEARTOFLOVE
        MENUITEM "Reload Christmas RibbonBox",  ID_EVENTLOAD_RIBBONBOX
        MENUITEM "Reload Valentine's Day Chocolate Box", 
                                                ID_EVENTLOAD_CHOCOLATEBOX
        MENUITEM "Reload White Day Candy Box",  ID_EVENTLOAD_CANDYBOX
        MENUITEM SEPARATOR
        MENUITEM "Reload NPC say HappyNewYear", ID_EVENTLOAD_SAY_HAPPYNEWYEAR

        MENUITEM "Reload NPC say Merry X-Mas",  ID_EVENTLOAD_SAY_MERRYXMAS
    END
    POPUP "Game ETC Load"
    BEGIN
        MENUITEM "Reload All ETC Option",       ID_ETCLOAD_ALL
        MENUITEM SEPARATOR
        MENUITEM "Reload Create Character",     ID_ETCLOAD_CREATECHAR
        MENUITEM "Reload Guild",                ID_ETCLOAD_GUILD
        MENUITEM "Reload Trade",                ID_ETCLOAD_TRADE
        MENUITEM "Reload Chaos Box",            ID_ETCLOAD_CHAOSBOX
        MENUITEM "Reload Personal Shop",        ID_ETCLOAD_PSHOP
        MENUITEM "Reload PK Item Drop",         ID_ETCLOAD_PKITEMDROP
        MENUITEM "Reload Item Drop Rate",       ID_ETCLOAD_ITEMDROPRATE
        MENUITEM "Reload SpeedHack",            ID_ETCLOAD_SPEEDHACK
        MENUITEM "Reload GameGuard Checksum Check", ID_ETCLOAD_GAMEGUARD
    END
    POPUP "&View"
    BEGIN
        MENUITEM "Log Paint",                   ID_VIEW_LOG
        MENUITEM "Log CastleSiege",             ID_VIEW_LOG_CS
        MENUITEM SEPARATOR
        MENUITEM "Map1",                        ID_MAP_1, GRAYED
        MENUITEM "Map2",                        ID_MAP_2, GRAYED
        MENUITEM "Map3",                        ID_MAP_3, GRAYED
        MENUITEM "Map4",                        ID_MAP_4, GRAYED
        MENUITEM "Crywolf",                     ID_MAP_CRYWOLF
    END
    POPUP "Etc"
    BEGIN
        MENUITEM "Dragon Event",                ID_MENUITEM_EVENT
        MENUITEM "StartOfXMas Event",           ID_MENUITEM_STAROFXMAS_EVENT
        MENUITEM "FireCracker",                 ID_MENUITEM_FIRECRACKER_EVENT

    END
    POPUP "Msg"
    BEGIN
        MENUITEM "5 Minute Close",              ID_MENU_FIVECLOSE
        MENUITEM "3 Minute Close",              ID_MENU_THREECLOSE
        MENUITEM "1 Minute Close",              ID_MENU_ONECLOSE
    END
    POPUP "Alert"
    BEGIN
        MENUITEM "All &Clear",                  IDM_ALERT_ALL_CLEAR
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About ...",                  IDM_ABOUT
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// Accelerator
//

IDC_GAMESERVER ACCELERATORS MOVEABLE PURE 
BEGIN
    "?",            IDM_ABOUT,              ASCII,  ALT
    "/",            IDM_ABOUT,              ASCII,  ALT
END


/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOG DISCARDABLE  22, 17, 230, 53
STYLE DS_MODALFRAME | WS_CAPTION | WS_SYSMENU
CAPTION "About"
FONT 8, "System"
BEGIN
    ICON            IDI_GAMESERVER,IDC_MYICON,14,9,20,20
    LTEXT           "GameServer Version 1.00.92",IDC_STATIC,49,10,123,8,
                    SS_NOPREFIX
    LTEXT           "Copyright (C) 2008 Webzen Inc.",IDC_STATIC,49,20,119,8
    DEFPUSHBUTTON   "OK",IDOK,195,6,30,11,WS_GROUP
    LTEXT           "오토프로그램 이동관련 핵대응",IDC_STATIC,49,32,167,10,
                    SS_NOPREFIX
END

IDD_DLG_GUILDLISTSTATE DIALOG DISCARDABLE  0, 0, 195, 27
STYLE DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Guild list state."
FONT 8, "System"
BEGIN
    CONTROL         "Progress1",IDC_LIST_PROGRESS,"msctls_progress32",0x0,7,
                    5,181,10
    RTEXT           "",IDC_LIST_STATE,7,16,181,11
END

IDD_CS_LOG_DLG DIALOG DISCARDABLE  0, 0, 313, 228
STYLE DS_MODALFRAME | DS_CENTER | WS_MAXIMIZEBOX | WS_POPUP | WS_CAPTION | 
    WS_SYSMENU
CAPTION "Castle Siege Log Dialog"
FONT 10, "MS Serif"
BEGIN
    LISTBOX         IDC_MAIN_LIST,7,7,299,214,LBS_NOINTEGRALHEIGHT | 
                    WS_VSCROLL | WS_TABSTOP
END


